# Supabase — Settings → API (solo clave "anon" / "public", nunca service_role en el front)
# En Vercel: Project → Settings → Environment Variables (no subas .env.local al repo)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public site URL (no trailing slash). Required in production so OAuth redirects match Supabase allow list.
# Use the same origin in the Worker ALLOWED_ORIGINS var (wrangler production) for CORS.
# Local: omit or leave unset. Vercel: https://YOUR_PROJECT.vercel.app or your custom domain
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Backend — URL pública del Worker (webhooks, texto en UI). Puede incluir prefijo de ruta (p. ej. https://api.dominio.com/gateway).
# El rewrite /worker-api/* concatena esta base + api/... → …/gateway/api/... . En el Worker, WORKER_URL debe usar la misma base (path incluido) o definir SENTINEL_HTTP_PATH_PREFIX=/gateway en wrangler.
NEXT_PUBLIC_API_URL=http://localhost:8787
#
# El dashboard llama al API vía mismo origen /worker-api (rewrite en next.config.mjs).
# Opcional: destino solo servidor (misma URL base que el Worker, con o sin /gateway).
# BACKEND_PROXY_URL=https://your-worker-subdomain.workers.dev

# true: precios en landing, #pricing, /dashboard/billing y /docs/facturacion. false: oculta compras/precios/facturación en el front (también: NEXT_PUBLIC_ALLOW_PRICES=true)
# ALLOW_PRICES=true

# Chat (Arsi) y Sales — base pública hasta el prefijo de ruta del Worker (sin barra final).
# El front hace POST a {base}/chat y {base}/email/contact. Ej.: base …/chatbot → …/chatbot/chat; base …/sales → …/sales/email/contact.
# Con https:// el navegador usa /worker-api-chat y /worker-api-sales (rewrites en next.config.mjs). Local u otro puerto: http://127.0.0.1:8789.
# NEXT_PUBLIC_SENTINEL_CHAT_WORKER_URL=https://api.tudominio.com/chatbot
# NEXT_PUBLIC_SENTINEL_SALES_WORKER_URL=https://api.tudominio.com/sales
# Opcional: destino del rewrite solo en build (next.config); el widget igual necesita NEXT_PUBLIC_* para montarse.
# BACKEND_CHAT_PROXY_URL=
# BACKEND_SALES_PROXY_URL=
