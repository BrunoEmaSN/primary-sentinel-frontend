# Supabase — Settings → API (solo clave "anon" / "public", nunca service_role en el front)
# En Vercel: Project → Settings → Environment Variables (no subas .env.local al repo)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public site URL (no trailing slash). Required in production so OAuth redirects match Supabase allow list.
# Use the same origin in the Worker ALLOWED_ORIGINS var (wrangler production) for CORS.
# Local: omit or leave unset. Vercel: https://YOUR_PROJECT.vercel.app or your custom domain
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Backend — your Cloudflare Worker URL
NEXT_PUBLIC_API_URL=http://localhost:8787
# Production: NEXT_PUBLIC_API_URL=https://your-worker-subdomain.workers.dev

# Precios en landing, enlaces a #pricing y tarifas en /dashboard/billing (también válido: NEXT_PUBLIC_ALLOW_PRICES=true)
# ALLOW_PRICES=true

# Arsi widget — Worker base URL (POST /chat). If unset, the chat bubble is not rendered.
# NEXT_PUBLIC_SENTINEL_CHAT_WORKER_URL=https://your-sentinel-chat.workers.dev

# Lema / sales — Worker base URL (POST /email/contact). Separado del chat. Si no está, no se muestra el widget.
# NEXT_PUBLIC_SENTINEL_SALES_WORKER_URL=https://your-sentinel-sales.workers.dev
